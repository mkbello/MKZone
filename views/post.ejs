<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather&family=Poppins:wght@500&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/styles/layout.css">
</head>

<body class="d-flex flex-column min-vh-100">

    <%- include("partials/navbar.ejs") %>

        <section class="flex-grow-1 container" style=" padding-bottom: 100px;">
            <h1 class="mkzone-blog slide-in slide-in-1">MKZone</h1>
            <p class="blog-paragraph slide-in slide-in-2">Discover stories, tips, and insights across tech, life,
                and
                more.
            </p>

            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">

                        <div class="card shadow-lg border-0 mb-4 slide-in slide-in-3">

                            <img src="<%= post.image_url %>" class="blog-image rounded-top" alt="<%= post.title %>"
                                onerror="this.onerror=null;this.src='/images/default.png';">


                            <div class="card-body">
                                <h1 class="post-h1 mb-3">
                                    <%= post.title.charAt(0).toUpperCase() + post.title.slice(1) %>
                                </h1>

                                <pre
                                    class="post-content"> <%= post.content.charAt(0).toUpperCase() + post.content.slice(1) %>  </pre>


                                <% if (user) { %>
                                    <button class="like-btn like-property" data-postid="<%= post.id %>"
                                        data-liked="<%= post.user_liked ? 'true' : 'false' %>">

                                        <% if (post.user_liked) { %>
                                            <i class="fa-solid fa-thumbs-up liked"></i>
                                            <% } else { %>
                                                <i class="fa-regular fa-thumbs-up"></i>
                                                <% } %>
                                    </button>

                                    <span class="like-property" id="like-count-<%= post.id %>">
                                        <%= post.like_count %>
                                    </span>
                                    <% } else { %>

                                        <span class="like-property">
                                            <i class="fa-regular fa-thumbs-up"></i>
                                            <%= post.like_count %>
                                        </span>

                                        <p><a class="no-line" href="/login">Login</a> to like post.</p>

                                        <% } %>



                                            <p class="text-end post-author">
                                                Posted by <span class="author-name">
                                                    <%= post.username %>
                                                </span> on
                                                <%= new Date(post.created_at).toLocaleString("en-US", { month: "short" ,
                                                    day: "numeric" , year: "numeric" }) %>
                                            </p>
                                            <div class="edit-delete">
                                                <% if (user && user.id===post.user_id) { %>
                                                    <a href="/posts/<%= post.id %>/edit" class="edit-post-button">Edit
                                                        Post</a>
                                                    <% } %>


                                                        <% if (user && user.id===post.user_id) { %>

                                                            <button type="button" class="delete-post-btn"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#deletePostModal">
                                                                Delete Post
                                                            </button>

                                                            <% } %>
                                            </div>
                            </div>
                        </div>


                        <div class="card shadow-sm border-0 mb-4 slide-in slide-in-3">
                            <div class="card-body ">


                                <% if (user) { %>
                                    <form class="comment-form" data-post-id="<%= post.id %>">
                                        <label for="comment" class="block mb-2 font-semibold">Leave a Comment</label>
                                        <textarea name="content" placeholder="Write your comment..."
                                            required></textarea>
                                        <button type="submit">Comment</button>
                                    </form>

                                    <% } else { %>
                                        <p><a class="no-line" href="/login">Login</a> to comment on post.</p>
                                        <% } %>

                                            <button class="toggle-comments show-comments" data-id="<%= post.id %>">Show
                                                Comments</button>

                                            <div id="comments-<%= post.id %>" class="comments-box">
                                                <h3 class="mb-4">All comments</h3>


                                                <p id="no-comments-<%= post.id %>"
                                                    class="text-muted <%= comments.length ? 'd-none' : '' %>"
                                                    data-post-id="<%= post.id %>">
                                                    No comments yet. Be the first to comment!
                                                </p>

                                                <ul class="list-group list-group-flush" id="comment-list-<%= post.id %>"
                                                    data-post-id="<%= post.id %>">
                                                    <% comments.forEach(c=> { %>
                                                        <li class="comment" data-id="<%= c.id %>">
                                                            <p class="comment-meta">
                                                                <strong>
                                                                    <%= c.username %>
                                                                </strong> •
                                                                <%= new Date(c.created_at).toLocaleString("en-US", {
                                                                    month: "short" , day: "numeric" , year: "numeric" ,
                                                                    hour: "2-digit" , minute: "2-digit" }) %>
                                                            </p>
                                                            <p class="comment-content">
                                                                <%= c.content.charAt(0).toUpperCase() +
                                                                    c.content.slice(1) %>
                                                            </p>

                                                            <% if (user && user.id===c.user_id) { %>

                                                                <button class="comment-btn delete-comment"
                                                                    data-id="<%= c.id %>">Delete Comment</button>
                                                                <% } %>
                                                        </li>
                                                        <% }) %>
                                                </ul>

                                            </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <%- include("partials/deletePostModal") %>
        </section>
        <%- include("partials/footer.ejs") %>
            <script src="/js/ui.js"></script>
            <script src="/js/post.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
