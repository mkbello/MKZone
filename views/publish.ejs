<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Merriweather&family=Poppins:wght@500&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/styles/layout.css">
</head>

<body class="d-flex flex-column min-vh-100">

    <%- include("partials/navbar.ejs") %>

        <section class="flex-grow-1" style=" padding-bottom: 100px;">
            <h1 class="publish-h1">Create a Post</h1>
            <% if (user) { %>

                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="form-container">
                            <% if (success) { %>
                                <p class="publish-success">
                                    <%= success %>
                                </p>
                                <% } %>
                                    <form method="POST" action="/publish" class="form">
                                        <div class="mb-3">
                                            <label for="title" class="form-label">Title</label>
                                            <input type="text" class="form-control" name="title" maxlength="200"
                                                required />
                                        </div>
                                        <div class="mb-3">
                                            <label for="image" class="form-label">Image Url (Optional)</label>
                                            <input type="text" class="form-control" name="img" />
                                        </div>
                                        <div class="mb-3">
                                            <label for="content" class="form-label">Share your thoughts...</label>
                                            <textarea type="text" class="form-control" name="content" rows="5"
                                                required></textarea>
                                        </div>
                                        <button type="submit" class="btn custom-btn w-100">Publish</button>
                                    </form>

                        </div>
                    </div>
                </div>

                <div class="user-posts">
                    <h1>Your Posts</h1>

                    <% if (posts.length===0) { %>

                        <p class="no-post-yet">You have no posts yet.</p>

                        <% } else { %>
                            <div class="blog-card">

                                <% posts.forEach(post=> { %>

                                    <div class="blog-content">
                                        <a class="blog-title" href="/posts/<%= post.id %>">


                                            <img src="<%= post.image_url %>" class="blog-image rounded-top"
                                                alt="<%= post.title %>"
                                                onerror="this.onerror=null;this.src='/images/default.png';">

                                            <h2>
                                                <%= post.title.charAt(0).toUpperCase() + post.title.slice(1) %>
                                            </h2>

                                            <p class="author-paragraph">
                                                <span class="likeCountSpan">
                                                    <i class="fa-regular fa-thumbs-up"></i>
                                                    <%= post.like_count %>
                                                </span>
                                                Posted by <span class="author-name">
                                                    <%= post.username %>
                                                </span> on
                                                <%= new Date(post.created_at).toLocaleString("en-US", { month: "short" ,
                                                    day: "numeric" , year: "numeric" }) %>
                                            </p>

                                        </a>
                                    </div>
                                    <% }) %>
                            </div>

                            <% } %>

                </div>
                <% } else { %>
                    <div class="row justify-content-center">
                        <div class="create-post col-lg-8">
                            <p class="publish-paragraph">Please <a class="publish-login" href="/login">login</a> to
                                create a
                                post.</p>
                        </div>
                    </div>
                    <% } %>
        </section>


        <%- include("partials/footer.ejs") %>

            <script src="/js/ui.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
